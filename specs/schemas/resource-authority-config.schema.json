{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-authority-config.schema.json",
  "title": "Workbench Resource Authority Configuration",
  "description": "Declares executable providers and exactly one live authority for each resource type/set pair.",
  "type": "object",
  "additionalProperties": false,
  "required": ["Providers", "ResourceSets", "DefaultTimeoutSeconds"],
  "properties": {
    "DefaultTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "Providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    },
    "ResourceSets": {
      "type": "array",
      "items": { "$ref": "#/$defs/authorityBinding" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Id", "Executable", "Arguments", "Enabled"],
      "properties": {
        "Id": { "type": "string", "minLength": 1 },
        "Executable": { "type": "string", "minLength": 1 },
        "Arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "WorkingDirectory": { "type": ["string", "null"] },
        "TimeoutSeconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 3600
        },
        "Enabled": { "type": "boolean" }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ResourceType",
        "ResourceSet",
        "AuthorityProvider",
        "ReadOnlyEnrichers",
        "PublicationTargets",
        "ConflictPolicy",
        "OfflinePolicy"
      ],
      "properties": {
        "ResourceType": { "type": "string", "minLength": 1 },
        "ResourceSet": { "type": "string", "minLength": 1 },
        "AuthorityProvider": { "type": "string", "minLength": 1 },
        "ReadOnlyEnrichers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "PublicationTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ConflictPolicy": { "const": "fail" },
        "OfflinePolicy": { "const": "store-and-forward" }
      }
    }
  }
}
